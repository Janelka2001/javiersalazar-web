---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { siteReadyForIndexing } from '../lib/seo';
import '../styles/global.css';

interface SocialImage {
	src: string;
	width: number;
	height: number;
	alt: string;
	type?: string;
}

interface Props {
	title?: string;
	description?: string;
	image?: SocialImage;
	type?: 'website' | 'article' | 'profile';
	publishedTime?: string;
	modifiedTime?: string;
	noindex?: boolean;
	canonical?: string | false;
	prev?: string;
	next?: string;
	structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
	title,
	description = 'Fotografía de Javier Salazar. El mundo a través de mis ojos.',
	image = {
		src: '/og.png',
		width: 1200,
		height: 630,
		alt: 'Javier Salazar · El mundo a través de mis ojos',
		type: 'image/png',
	},
	type = 'website',
	publishedTime,
	modifiedTime,
	noindex = false,
	canonical: canonicalOverride,
	prev,
	next,
	structuredData = [],
} = Astro.props;

const documentTitle = title ? `${title} · Javier Salazar` : 'Javier Salazar · El mundo a través de mis ojos';
const canonical = canonicalOverride === false
	? undefined
	: Astro.site
		? new URL(canonicalOverride || Astro.url.pathname, Astro.site)
		: undefined;
const siteUrl = Astro.site ? new URL('/', Astro.site) : undefined;
const socialImageOrigin = !siteReadyForIndexing && import.meta.env.CF_PAGES_URL
	? new URL(import.meta.env.CF_PAGES_URL)
	: Astro.site;
const imageUrl = socialImageOrigin ? new URL(image.src, socialImageOrigin) : undefined;
const rssUrl = Astro.site ? new URL('/rss.xml', Astro.site) : '/rss.xml';
const sitemapUrl = Astro.site ? new URL('/sitemap-index.xml', Astro.site) : '/sitemap-index.xml';
const shouldIndex = siteReadyForIndexing && !noindex;
const robots = shouldIndex
	? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
	: 'noindex, follow, max-image-preview:large';
const pageStructuredData = Array.isArray(structuredData) ? structuredData : [structuredData];
const jsonLd = siteUrl
	? {
			'@context': 'https://schema.org',
			'@graph': [
				{
					'@type': 'WebSite',
					'@id': `${siteUrl.href}#website`,
					url: siteUrl.href,
					name: 'Javier Salazar',
					alternateName: 'El mundo a través de mis ojos',
					description: 'El mundo a través de mis ojos.',
					inLanguage: 'es',
					publisher: { '@id': `${siteUrl.href}#javier-salazar` },
				},
				{
					'@type': 'Person',
					'@id': `${siteUrl.href}#javier-salazar`,
					name: 'Javier Salazar Martínez',
					alternateName: 'Javier Salazar',
					url: siteUrl.href,
					jobTitle: 'Fotógrafo',
				},
				...pageStructuredData,
			],
		}
	: undefined;
const serializedJsonLd = jsonLd ? JSON.stringify(jsonLd).replaceAll('<', '\\u003c') : undefined;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="author" content="Javier Salazar Martínez" />
		<meta name="copyright" content="Javier Salazar" />
		<meta name="robots" content={robots} />
		<meta name="theme-color" content="#ffffff" />

		<meta property="og:site_name" content="Javier Salazar" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={documentTitle} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical.href} />}
		{imageUrl && <meta property="og:image" content={imageUrl.href} />}
		{imageUrl && <meta property="og:image:secure_url" content={imageUrl.href} />}
		{image.type && <meta property="og:image:type" content={image.type} />}
		<meta property="og:image:width" content={String(image.width)} />
		<meta property="og:image:height" content={String(image.height)} />
		<meta property="og:image:alt" content={image.alt} />
		{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
		{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
		{type === 'article' && siteUrl && <meta property="article:author" content={`${siteUrl.href}#javier-salazar`} />}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={documentTitle} />
		<meta name="twitter:description" content={description} />
		{imageUrl && <meta name="twitter:image" content={imageUrl.href} />}
		<meta name="twitter:image:alt" content={image.alt} />

		<link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
		<link rel="icon" sizes="32x32" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="alternate" type="application/rss+xml" title="Fotografías de Javier Salazar" href={rssUrl} />
		<link rel="sitemap" href={sitemapUrl} />
		{canonical && <link rel="canonical" href={canonical.href} />}
		{prev && <link rel="prev" href={prev} />}
		{next && <link rel="next" href={next} />}
		{serializedJsonLd && <script type="application/ld+json" is:inline set:html={serializedJsonLd}></script>}
		<title>{documentTitle}</title>
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<SiteHeader pathname={Astro.url.pathname} />
		<main id="contenido" class="shell">
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>
