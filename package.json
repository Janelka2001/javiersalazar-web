{
	"name": "javiersalazar-es",
	"type": "module",
	"version": "0.1.0",
	"private": true,
	"license": "UNLICENSED",
	"repository": {
		"type": "git",
		"url": "https://github.com/Janelka2001/javiersalazar-web.git"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev --background",
		"dev:foreground": "astro dev",
		"dev:status": "astro dev status",
		"dev:logs": "astro dev logs",
		"dev:stop": "astro dev stop",
		"content:sanitize": "node scripts/sanitize_photo_catalog.mjs",
		"content:check": "node scripts/sanitize_photo_catalog.mjs --check",
		"check": "astro check",
		"check:assets": "node scripts/validate-photo-assets.mjs",
		"check:output": "node scripts/validate-static-output.mjs",
		"build": "node scripts/assert-site-readiness.mjs && astro build && node scripts/prune-unreferenced-photo-originals.mjs",
		"qa": "npm run check && npm run content:check && npm run check:assets && npm run build && node scripts/validate-seo.mjs && npm run check:output",
		"qa:production": "SITE_READY=true npm run qa",
		"preview": "astro preview",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.3",
		"astro": "7.2.2",
		"sharp": "0.35.3"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"typescript": "6.0.3"
	}
}
